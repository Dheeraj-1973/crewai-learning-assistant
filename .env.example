# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is listed in .gitignore, so your real key is never committed.

# --- Required ---------------------------------------------------------------
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Optional (defaults shown) -------------------------------------------------
# development | production   (production hides /docs unless ENABLE_API_DOCS=true)
APP_ENV=development

# LLM tuning. The model itself is fixed in code: groq/openai/gpt-oss-20b
LLM_TEMPERATURE=0.4
# gpt-oss is a reasoning model; hidden reasoning also uses tokens, so keep this generous.
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=120
# low | medium | high, or leave empty to use the provider default.
LLM_REASONING_EFFORT=low
# Print every agent step in the terminal (useful while learning, noisy otherwise).
CREW_VERBOSE=false

# Relative SQLite paths are resolved inside the backend/ folder.
DATABASE_URL=sqlite:///./data/learning_assistant.db

# Comma-separated list of websites allowed to call the API from a browser.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500

# Serve the website from the backend at http://127.0.0.1:8000/app/
SERVE_FRONTEND=true

# Protects your Groq quota: new topics are refused while this many are running.
MAX_ACTIVE_GENERATIONS=2

# Turn off CrewAI's anonymous telemetry (the app also sets this by default).
CREWAI_DISABLE_TELEMETRY=true
